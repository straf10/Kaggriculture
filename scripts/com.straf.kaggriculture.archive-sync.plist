<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Local launchd job for analysis/archive_sync.py (ROADMAP §3.2/§9/§11).

  Why launchd and not a GitHub Action: the artefacts (replay JSON, leaderboard CSVs)
  must land on THIS machine's disk — they are gitignored under data/archive/ and an
  Action has nowhere durable to put them without a separate commit/artifact-upload
  step, which would either bloat the repo (replays are ~1.3 MB gzipped each, hundreds
  of them) or require standing up cloud storage for a single-laptop project. The token
  also never needs to leave the local .env this way.

  Alternative considered: a scheduled Kaggle kernel that reads the same public API and
  writes a Kaggle Dataset on a cron. Trade-off — it runs even with this laptop off/asleep
  (launchd does not: a missed StartCalendarInterval while asleep just waits for the next
  wake, it does not queue), but the output is a Kaggle Dataset, not local files, so every
  downstream analysis script here would need an extra `kaggle datasets download` step
  before it could read anything. Not worth it while this is a single-machine project.

  ---- Install ----
    cp scripts/com.straf.kaggriculture.archive-sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.straf.kaggriculture.archive-sync.plist

  ---- Run once now (without waiting for the schedule) ----
    launchctl start com.straf.kaggriculture.archive-sync

  ---- Check status / last exit code ----
    launchctl list | grep kaggriculture
    tail -f data/archive/logs/archive_sync.out.log
    tail -f data/archive/logs/archive_sync.err.log

  ---- Uninstall ----
    launchctl unload ~/Library/LaunchAgents/com.straf.kaggriculture.archive-sync.plist
    rm ~/Library/LaunchAgents/com.straf.kaggriculture.archive-sync.plist

  Runs daily at 06:15 local time (episodes accrue at ~1-2/hour per ROADMAP §2, so once
  a day is plenty; adjust Hour/Minute below if you want tighter freshness before the
  09-30 deadline). A missed run (laptop asleep/off at 06:15) is NOT re-queued — it just
  waits for the next scheduled minute, so `launchctl start` after waking the machine is
  the manual catch-up.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.straf.kaggriculture.archive-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/straf/Python/Kaggriculture/scripts/archive_sync_launchd.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/straf/Python/Kaggriculture</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/straf/Python/Kaggriculture/data/archive/logs/archive_sync.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/straf/Python/Kaggriculture/data/archive/logs/archive_sync.err.log</string>

    <!-- Exit non-2xx doesn't restart the job by itself under StartCalendarInterval
         (that scheduling mode isn't KeepAlive-driven) — this just stops launchd from
         also treating a normal exit as a crash to be relaunched immediately. -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>

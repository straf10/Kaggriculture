.venv/
__pycache__/
*.pyc
.env
runs/
submission.tar.gz

# Experiment/run output — regenerated locally, not source code
baselines/
# gates/: ignore everything EXCEPT results.json (R34, user-approved 2026-08-18) — the aggregate
# gate evidence (bank stats, priced-loss, counters, agent-spec paths; no per-step action streams,
# no §2.4b competition-data exposure) is versioned so it is not single-laptop like R14. Replays,
# draws and confirm logs under gates/ stay local.
/gates/**
!/gates/**/
!/gates/**/results.json

# checkpoints/: immutable local baselines (ROADMAP R14, decided 2026-08-11). The agent packages
# themselves stay out of git — ~20 near-identical copies of agent/ — but every manifest.json IS
# tracked, so the fingerprint of each accepted baseline is recoverable from history and any gate
# artefact that cites one can still be checked. This is the compromise between the invariant
# harness/checkpoint.py names (review H2: checkpoints were moved out of runs/ precisely so
# accepted baselines would not vanish from git) and not committing the packages.
#
# The three lines below must stay in this order: git cannot re-include a file whose parent
# directory is itself excluded, so the directories are un-ignored before the manifests are.
/checkpoints/**
!/checkpoints/**/
!/checkpoints/*/manifest.json

# Kaggle notebooks — large embedded outputs, not part of the agent/harness source.
# Leading slash matters: a bare `notebooks/` also swallowed docs/source/notebooks/,
# which holds the small tracked markdown extracts every doc reference points at.
/notebooks/

# Scraped/derived meta datasets — not needed to build or run the agent
data/archive/
data/kaggriculture-episodes/

# Raw AI code-review dumps — internal working notes
docs/reviews/

# R25: the MIT tier-0-5 reference agents (Rayk Kretzschmar, kaggriculture-reference-agents).
# MIT permits redistribution, but they are not ours to carry in this public repo and nothing
# needs them to be (ROADMAP §4.5). Fetched locally only. Tiers 6-9 and the CC BY-SA CSVs are
# never fetched (R23 / §4.5).
/harness/bench_agents/reference/

# S6-step-0 derived outputs computed by replaying the gitignored donor tapes — derived from
# competition data, kept local (§2.4b). Leg 3 (data/derived/s6_step0_leg3.json) is from the
# public dataset and stays tracked.
/data/derived/s6_step0_leg1.json
/data/derived/s6_step0_leg1_smoke.json
/data/derived/s6_step0_leg2.json

# S6-step-1 Phase 0 (donor selection) — inventories, fingerprints, agreement, calendar and the
# reconstruction are all derived from competition action streams; kept local (§2.4b / R11).
/data/derived/s6_step1_inventory.jsonl
/data/derived/s6_step1_clusters.json
/data/derived/s6_step1_agreement.json
/data/derived/s6_step1_calendar.json
/data/derived/s6_step1_calendar_replay.json
/data/derived/s6_step1_replay_0-23.log
/data/derived/s6_step1_reconstruction_*.json
/data/derived/s6_step1_shed_*.json
/data/derived/s6_step1_bank_*.json

# S6-step-1b (package/gate/ship) — cluster split, R21 shop-draw summaries and gate replay dirs are
# all derived from the competition action streams; kept local (§2.4b / R11).
/data/derived/s6_step1b_cluster_*.json
/data/derived/s6_step1b_gate_draw_*.json
/data/derived/s6_step1b_gate_*/

# S6 step 2a Phase 0 — per-episode own-farm loss decomposition, computed by replaying the
# gitignored reconstruction package; derived from competition action streams, kept local (§2.4b).
/data/derived/s6_step2a_phase0.json

# S6 step 2b Phase 0 — per-episode extract of our own live public episodes (opponent names, banks,
# realised premium $/u); derived from competition action streams (the downloaded replays under
# data/archive/, itself gitignored), kept local (§2.4b / R11).
/data/derived/s6_step2b_live.json

# S6 step 2b Phase 0.5 — the recovered donor strawberry sell-rule (determinism across towns,
# hour-of-day calendar, live reachability); derived from the donor + live action streams, local (§2.4b / R11).
/data/derived/s6_step2b_phase05.json

# S6 step 2c — the non-strawberry town-conditioning sweep (WOOL/MILK/WHEAT/MELON per-product
# determinism, within-step drain split, drift ceiling); derived from the donor action streams (§2.4b / R11).
/data/derived/s6_step2c.json

# S6 step 2d (Track 2) — production-channel town-reactivity (leg A) + bank decomposition / loss
# ledger (leg B); derived from the donor + live 55586926 action streams (§2.4b / R11).
/data/derived/s6_step2d.json
